# kiro-lb — bootstrap only. Accounts are added via the dashboard (device login).

# Required: password for /v1 and /metrics (you invent this)
# Generate: openssl rand -hex 32
PROXY_API_KEY="replace-with-a-long-random-value"

# Required for the operations dashboard at /
# Generate: openssl rand -base64 32
DASHBOARD_PASSWORD="replace-with-a-unique-secret"

# --- optional deploy ---
# SERVER_HOST="0.0.0.0"
# SERVER_PORT="8000"
# DASHBOARD_DATA_DIR="data"
# DASHBOARD_SECURE_COOKIE="true"
# VPN_PROXY_URL=""
# LOG_LEVEL="INFO"
# DEBUG_MODE=off
# DEBUG_DIR="debug_logs"
# HANDOFF_SECRET=""   # blue/green only
# KIRO_SLOT=""        # blue/green only

# Payload guard. Kiro's CONTENT_LENGTH_EXCEEDS_THRESHOLD tracks cl100k tokens
# of the compact JSON. claude-opus-5: 800000 Hangul pass, 1000000 fail
# (2026-08-23). The byte cap is a legacy ASCII-only bisect; set 0 to disable.
# KIRO_MAX_PAYLOAD_TOKENS=800000
# KIRO_MAX_PAYLOAD_BYTES=1085435
# AUTO_TRIM_PAYLOAD=false

# ==============================================================================
# Endpoint Rotation
# ==============================================================================
# Values below apply on first run only. After that, edit them in the dashboard.
#
# Rotate to another endpoint when one fails with a 5xx or a transport error.
# A 429 or a suspension 403 belongs to the account, so it never rotates.
KIRO_ENDPOINT_ROTATION=false
# Attempt order. Available: runtime, codewhisperer, amazonq
KIRO_ENDPOINT_ORDER=amazonq,codewhisperer,runtime
# Seconds a failing endpoint stays at the back of the queue. It is never removed.
KIRO_ENDPOINT_COOLDOWN_SECONDS=30

# ==============================================================================
# Request shaping
# ==============================================================================
# Task mode sent to Kiro. The official CLI sends "vibe" for chat, and uses
# "spec" and "task" for its other modes. Leave empty to omit the field.
# KIRO_AGENT_TASK_TYPE=vibe

# Replace Anthropic's generic prompt sections with a short Kiro one. Your rules,
# the memory path, environment and language are kept. Does not affect latency.
# CONDENSE_CLAUDE_PROMPT=false

# ==============================================================================
# Pool behaviour
# ==============================================================================
# Seconds before expiry to refresh a token. Range 60..3600.
# TOKEN_REFRESH_THRESHOLD=600

# Account ordering: weighted (default), sticky, or most_credits.
# Set it in the dashboard. ACCOUNT_QUOTA_WEIGHTED_ROUTING=false forces sticky.

# Accounts can be disabled in the dashboard without deleting them.

# ==============================================================================
# Request log
# ==============================================================================
# Days to keep request logs.
# REQUEST_LOG_RETENTION_DAYS=7

# Store the prompt and system prompt so the dashboard can show them. Off by
# default. Text is encrypted with LOG_ENCRYPTION_KEY before being written.
# CAPTURE_REQUEST_TEXT=false
# Max characters kept per field.
# CAPTURE_REQUEST_TEXT_MAX_CHARS=20000

# Key used to encrypt stored prompts. Generated on first run and written here.
# Losing it makes stored prompts unreadable; deleting it stops new text.
# LOG_ENCRYPTION_KEY=

# ==============================================================================
# Proxies
# ==============================================================================
# Single proxy for every request. For an ordered list with failover, use the
# Proxies section in the dashboard instead.
# VPN_PROXY_URL="socks5h://127.0.0.1:1080"

# ==============================================================================
# Concurrency
# ==============================================================================
# Caps on generation requests in flight, set in the dashboard. 0 means no cap.
# A request that waits longer than the queue timeout fails with 503.
