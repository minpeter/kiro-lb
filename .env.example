# kiro-lb — bootstrap only. Accounts are added via the dashboard (device login).
# Read from .env in the working directory (or a parent). Real environment
# variables take precedence over this file.

# Required: password for /v1 and /metrics (you invent this)
# Generate: openssl rand -hex 32
PROXY_API_KEY="replace-with-a-long-random-value"

# Required for the operations dashboard at /
# Generate: openssl rand -base64 32
DASHBOARD_PASSWORD="replace-with-a-unique-secret"

# Open the dashboard without a password. Only for a gateway reachable from this
# machine alone (with Docker, publish 127.0.0.1:8000:8000). /v1 still needs a key.
# DASHBOARD_AUTH=false

# --- optional deploy ---
# SERVER_HOST="0.0.0.0"
# SERVER_PORT="8000"
# Directory holding dashboard.sqlite3. The schema is the same one kiro-lb uses,
# so pointing both at one directory shares accounts, keys and history.
# DASHBOARD_DATA_DIR="data"
# DASHBOARD_SECURE_COOKIE="true"
# Browser-facing TokenHub dashboard for diagnostic source chips (no API URL or credentials).
# TOKENHUB_DASHBOARD_URL="https://tokenhub.example.com/"
# VPN_PROXY_URL=""
# LOG_LEVEL="INFO"          # TRACE, DEBUG, INFO, WARNING, ERROR
# RUST_LOG=""               # overrides LOG_LEVEL with a tracing filter, e.g. "kiro_lb=debug"
# DEBUG_MODE=off            # off, errors, all
# DEBUG_DIR="debug_logs"
# DEBUG_CAPTURE_CONTENT=false
# DEBUG_CAPTURE_SUCCESS=false
# HANDOFF_SECRET=""         # blue/green; also authorizes POST /_internal/accounts/register
# KIRO_SLOT=""              # blue/green only

# Payload guard. Kiro's CONTENT_LENGTH_EXCEEDS_THRESHOLD tracks cl100k tokens
# of the compact JSON. claude-opus-5: 800000 Hangul pass, 1000000 fail
# (2026-08-23). The byte cap is a legacy ASCII-only bisect; set 0 to disable.
KIRO_MAX_PAYLOAD_TOKENS=1000000
KIRO_MAX_PAYLOAD_BYTES=0
AUTO_TRIM_PAYLOAD=false

# ==============================================================================
# Streaming
# ==============================================================================
# Wait for the first upstream byte before cancelling and retrying the request.
# Each retry restarts generation from scratch, so too low a value cancels slow
# but legitimate turns.
FIRST_TOKEN_TIMEOUT=45
FIRST_TOKEN_MAX_RETRIES=2
# Maximum silence between chunks once the stream has started.
# STREAMING_READ_TIMEOUT=300

# ==============================================================================
# Endpoint Rotation
# ==============================================================================
# Values below apply on first run only. After that, edit them in the dashboard.
#
# Rotate to another endpoint when one fails with a 5xx or a transport error.
# A 429 or a suspension 403 belongs to the account, so it never rotates.
KIRO_ENDPOINT_ROTATION=true
# Attempt order. Available: runtime, codewhisperer, amazonq
KIRO_ENDPOINT_ORDER=amazonq,codewhisperer,runtime
# Seconds a failing endpoint stays at the back of the queue. It is never removed.
KIRO_ENDPOINT_COOLDOWN_SECONDS=30

# ==============================================================================
# Request shaping
# ==============================================================================

# Shorten Claude Code tool descriptions longer than SHORTEN_TOOL_THRESHOLD
# characters to their first paragraph plus the lines naming a required
# parameter. No tool is removed and no schema changes. Measured on a real
# Claude Code request: 99.7 KB -> 62.7 KB. Time to first token grows ~7ms/KB.
# Both are also toggled in the dashboard ("Claude Code prompt").
# SHORTEN_CLAUDE_TOOLS=true
# SHORTEN_TOOL_THRESHOLD=1200

# Append a fixed note to Claude Code's Write, Edit, MultiEdit and NotebookEdit
# descriptions: Kiro cuts long responses and a cut tool call is lost whole, so
# the model writes large files in parts. Also toggled in the dashboard.
# CLAUDE_WRITE_HINT=true

# Tool descriptions above this are moved into the system prompt (Kiro rejects
# very long ones). 0 disables, which Kiro will reject.
# TOOL_DESCRIPTION_MAX_LENGTH=10000

# Auto-inject a web_search tool (MCP emulation). Native Anthropic server-side
# web_search works regardless.
# WEB_SEARCH_ENABLED=false

# ==============================================================================
# Pool behaviour
# ==============================================================================
# Seconds before expiry to refresh a token. Range 60..1800.
# TOKEN_REFRESH_THRESHOLD=960

# Account ordering: weighted (default), sticky, most_credits, or session.
# Set it in the dashboard. ACCOUNT_QUOTA_WEIGHTED_ROUTING=false forces sticky.
#
# "session" keeps each conversation on one account so Kiro's per-account prompt
# cache stays warm (measured ~1.6s warm vs 2.4-6s cold to first byte). It falls
# back to weighted when that account is unavailable.
# SESSION_AFFINITY_TTL_SECONDS=7200
# SESSION_AFFINITY_CAPACITY=10000

# Free-tier routing. A request for any model a free-tier account's catalog
# serves tries free-tier accounts first; the rest of the pool follows. A live
# session pin still stays first, and an account with every concurrency slot
# taken stays last.
# An account is free when its upstream subscription type (or the tier it was
# registered with) is listed below, case-insensitively.
# FREE_TIER_SUBSCRIPTION_TYPES="Free,Q_DEVELOPER_STANDALONE_FREE"

# Circuit breaker and quarantines, in seconds.
# ACCOUNT_RECOVERY_TIMEOUT=60
# ACCOUNT_MAX_BACKOFF_MULTIPLIER=1440
# ACCOUNT_PROBABILISTIC_RETRY_CHANCE=0.1
# ACCOUNT_RATE_LIMIT_COOLDOWN=10
# ACCOUNT_QUOTA_QUARANTINE=21600
# ACCOUNT_QUOTA_RESET_MARGIN=300
# ACCOUNT_QUOTA_QUARANTINE_MAX=2764800
# ACCOUNT_SUSPENSION_QUARANTINE=86400
# ACCOUNT_AUTH_DEAD_QUARANTINE=86400
# ACCOUNT_UNKNOWN_QUOTA_WEIGHT=0.25
# ACCOUNT_DEPLETED_QUOTA_WEIGHT=0.01
# ACCOUNT_CACHE_TTL=43200

# Accounts can be disabled in the dashboard without deleting them.

# ==============================================================================
# Background work and retention
# ==============================================================================
# STATE_SAVE_INTERVAL_SECONDS=10
# USAGE_REFRESH_INTERVAL_SECONDS=900   # 0 disables the periodic usage poll
# REQUEST_LOG_RETENTION_DAYS=7         # metadata only; text is never stored
# RATE_OBSERVATION_RETENTION_DAYS=7
# RATE_WINDOW_SECONDS=60
# RATE_ESTIMATE_WINDOW_SECONDS=86400

# ==============================================================================
# Proxies
# ==============================================================================
# Single proxy for every request. For an ordered list with failover, use the
# Proxies section in the dashboard instead.
# VPN_PROXY_URL="socks5h://127.0.0.1:1080"

# ==============================================================================
# Concurrency
# ==============================================================================
# Caps on generation requests in flight, set in the dashboard. 0 means no cap.
# A request that waits longer than the queue timeout fails with 503.
